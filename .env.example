# Raw URL to your GitHub-hosted zimlist.txt
GITHUB_URL=https://raw.githubusercontent.com/MikeyMan83/pi-kiwix-survival/main/profiles/medical-survival-zimlist.txt

# Preferred for private repos: store token in a local file.
GITHUB_TOKEN_FILE=./secrets/github_token

# Optional fallback for public repos or quick testing.
# If set, this env value is used when token file is missing.
# Use a fine-grained GitHub token with read-only Contents permission.
GITHUB_TOKEN=

# Port exposed by native kiwix-serve
KIWIX_PORT=8080

# Weekly sync interval (seconds)
SYNC_INTERVAL_SECONDS=604800

# Host-side sync settings
ZIM_DATA_DIR=./zim_data

# AP mode settings (used by scripts/setup-ap.sh)
AP_SSID=pi-kiwix-survival
AP_PASSPHRASE=ChangeThisPassphrase123
AP_INTERFACE=wlan0
AP_ADDRESS=10.42.0.1/24
# ISO 3166-1 alpha-2 country code for wireless regulatory domain.
AP_COUNTRY_CODE=NL
