# Raw URL to your GitHub-hosted zimlist.txt
GITHUB_URL=https://raw.githubusercontent.com/MikeyMan83/pi-kiwix-survival/main/profiles/medical-survival-zimlist.txt

# Preferred for private repos: mount token file at ./secrets/github_token.
# The compose file maps that to /run/secrets/github_token in the container.
GITHUB_TOKEN_FILE=/run/secrets/github_token

# Optional fallback for public repos or quick testing.
# If set, this env value is used when token file is missing.
# Use a fine-grained GitHub token with read-only Contents permission.
GITHUB_TOKEN=

# Pin this for deterministic deployments if desired.
KIWIX_SERVER_IMAGE=ghcr.io/kiwix/kiwix-serve:latest

# Port exposed by kiwix-server
KIWIX_PORT=8080

# 24 hours
SYNC_INTERVAL_SECONDS=86400

# Tune if your connection can handle parallel downloads
ARIA2_MAX_CONCURRENT_DOWNLOADS=3
