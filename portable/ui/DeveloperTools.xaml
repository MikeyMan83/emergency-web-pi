<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Emergency Web Pi - Developer Tools"
        Width="980" Height="680" MinWidth="880" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI" FontSize="13" TextOptions.TextFormattingMode="Display"
        Background="#F4F6F9" SnapsToDevicePixels="True" UseLayoutRounding="True">
  <Window.Resources>
    <SolidColorBrush x:Key="CanvasBrush" Color="#F4F6F9"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#D8DFE8"/>
    <SolidColorBrush x:Key="InkBrush" Color="#1F2937"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#5B6B7C"/>
    <SolidColorBrush x:Key="BrandBrush" Color="#0F6B9D"/>
    <SolidColorBrush x:Key="BrandDarkBrush" Color="#0B527A"/>
    <SolidColorBrush x:Key="BrandTintBrush" Color="#E8F1F8"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#1E7B44"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#9A6A00"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#B3261E"/>
    <BooleanToVisibilityConverter x:Key="BoolToVis"/>

    <Style x:Key="PageTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="17"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
    </Style>
    <Style x:Key="MutedText" TargetType="TextBlock">
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="SectionLabel" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
    </Style>
    <Style x:Key="InputLabel" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button">
      <Setter Property="Background" Value="{StaticResource BrandBrush}"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="MinHeight" Value="34"/>
      <Setter Property="MinWidth" Value="120"/>
      <Setter Property="Padding" Value="16,7"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1" CornerRadius="7" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource BrandDarkBrush}"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BrandBrush}"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Background" Value="#C7CFD9"/><Setter Property="Foreground" Value="#F2F4F7"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
      <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
      <Setter Property="FontWeight" Value="Normal"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#EEF2F6"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BrandBrush}"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="#9AA7B4"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SmallButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="MinHeight" Value="28"/>
      <Setter Property="MinWidth" Value="0"/>
      <Setter Property="Padding" Value="10,4"/>
    </Style>

    <Style x:Key="PathInput" TargetType="TextBox">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontFamily" Value="Consolas"/>
      <Setter Property="Padding" Value="6,4"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
      <Setter Property="Background" Value="White"/>
    </Style>

    <Style x:Key="TabPagePanel" TargetType="StackPanel">
      <Setter Property="Margin" Value="4,8,4,4"/>
    </Style>

    <Style x:Key="LibraryCheck" TargetType="CheckBox">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="VerticalContentAlignment" Value="Top"/>
      <Setter Property="Margin" Value="0,4,0,4"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Border x:Name="Box" Width="16" Height="16" CornerRadius="4" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1.5" Background="White" VerticalAlignment="Top" Margin="0,2,0,0">
                <Path x:Name="Check" Data="M1,8 L5,12 L13,2" Stroke="{StaticResource SuccessBrush}" StrokeThickness="2" Stretch="Uniform" Margin="2" Visibility="Collapsed"/>
              </Border>
              <ContentPresenter Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Top"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource BrandBrush}"/>
                <Setter TargetName="Box" Property="Background" Value="{StaticResource BrandTintBrush}"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource BrandBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="LogBox" TargetType="TextBox">
      <Setter Property="IsReadOnly" Value="True"/>
      <Setter Property="FontFamily" Value="Consolas"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Background" Value="#F8FAFC"/>
      <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="8"/>
      <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="AcceptsReturn" Value="True"/>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="24,14">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="Developer Tools" Style="{StaticResource PageTitle}"/>
          <TextBlock Text="Advanced appliance builder, diagnostics, and direct recovery workflows. End users do not need this workspace." Style="{StaticResource MutedText}" Margin="0,2,0,0"/>
        </StackPanel>
        <Button x:Name="BtnDevClose" Grid.Column="1" Style="{StaticResource SmallButton}" Content="Close tools" VerticalAlignment="Center"/>
      </Grid>
    </Border>

    <TabControl x:Name="DevTabs" Grid.Row="1" Margin="16,12,16,8" Padding="0" BorderThickness="0" Background="Transparent" FontSize="13">
      <TabItem x:Name="TabBuild" Header="Build">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Style="{StaticResource TabPagePanel}">
            <TextBlock Text="Base system" Style="{StaticResource SectionLabel}"/>
            <TextBlock x:Name="DevBaseInfo" Style="{StaticResource MutedText}" Margin="0,4,0,14"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
              <Button x:Name="BtnCheckPrereqs" Style="{StaticResource SecondaryButton}" Content="Check prerequisites" Margin="0,0,10,0"/>
              <Button x:Name="BtnBuildImage" Style="{StaticResource PrimaryButton}" Content="Build image"/>
            </StackPanel>
            <TextBlock x:Name="DevBuildStatus" Style="{StaticResource MutedText}" Margin="0,0,0,12" Text="Prerequisites have not been checked."/>
            <CheckBox x:Name="ChkDevRawBuild" Content="Show raw build inputs" Margin="0,0,0,8"/>
            <StackPanel x:Name="DevRawBuild" Visibility="Collapsed">
              <Grid Margin="0,2,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="Base image path" Style="{StaticResource InputLabel}"/>
                <TextBox x:Name="TxtDevBaseImage" Grid.Column="1" Style="{StaticResource PathInput}" Margin="8,3,8,3"/>
                <Button x:Name="BtnDevBaseImageBrowse" Grid.Column="2" Style="{StaticResource SmallButton}" Content="Browse"/>
              </Grid>
              <Grid Margin="0,2,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="Config JSON" Style="{StaticResource InputLabel}"/>
                <TextBox x:Name="TxtDevConfig" Grid.Column="1" Style="{StaticResource PathInput}" Margin="8,3,8,3"/>
                <Button x:Name="BtnDevConfigBrowse" Grid.Column="2" Style="{StaticResource SmallButton}" Content="Browse"/>
              </Grid>
              <Grid Margin="0,2,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="ZIM source dir" Style="{StaticResource InputLabel}"/>
                <TextBox x:Name="TxtDevZimDir" Grid.Column="1" Style="{StaticResource PathInput}" Margin="8,3,8,3"/>
                <Button x:Name="BtnDevZimDirBrowse" Grid.Column="2" Style="{StaticResource SmallButton}" Content="Browse"/>
              </Grid>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem x:Name="TabContent" Header="Content">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Style="{StaticResource TabPagePanel}">
            <Grid Margin="0,0,0,8">
              <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock Text="Profile" Style="{StaticResource InputLabel}"/>
              <ComboBox x:Name="CmbDevProfiles" Grid.Column="1" Margin="8,3,8,3" MinHeight="26"/>
              <Button x:Name="BtnDevRefreshProfiles" Grid.Column="2" Style="{StaticResource SmallButton}" Content="Refresh" Margin="0,0,8,0"/>
              <Button x:Name="BtnDevLoadProfile" Grid.Column="3" Style="{StaticResource SmallButton}" Content="Load items"/>
            </Grid>
            <TextBlock x:Name="DevContentInfo" Style="{StaticResource MutedText}" Margin="0,0,0,10"/>
            <TextBlock Text="Libraries (checked = include)" Style="{StaticResource SectionLabel}" Margin="0,0,0,4"/>
            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Background="White" Padding="10,6">
              <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="260">
                <StackPanel x:Name="DevLibraryHost"/>
              </ScrollViewer>
            </Border>
            <CheckBox x:Name="ChkDevRawContent" Content="Show profile and cache paths" Margin="0,12,0,8"/>
            <StackPanel x:Name="DevRawContent" Visibility="Collapsed">
              <Grid Margin="0,2,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="Profile file" Style="{StaticResource InputLabel}"/>
                <TextBox x:Name="TxtDevProfilePath" Grid.Column="1" Style="{StaticResource PathInput}" Margin="8,3,8,3"/>
                <Button x:Name="BtnDevProfileBrowse" Grid.Column="2" Style="{StaticResource SmallButton}" Content="Browse"/>
              </Grid>
              <Grid Margin="0,2,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock Text="Cache dir" Style="{StaticResource InputLabel}"/>
                <TextBox x:Name="TxtDevCacheDir" Grid.Column="1" Style="{StaticResource PathInput}" Margin="8,3,0,3"/>
              </Grid>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem x:Name="TabSd" Header="SD &amp; Output">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Style="{StaticResource TabPagePanel}">
            <Grid Margin="0,0,0,8">
              <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock Text="Target SD card" Style="{StaticResource InputLabel}"/>
              <ComboBox x:Name="CmbDevDisks" Grid.Column="1" Margin="8,3,8,3" MinHeight="26"/>
              <Button x:Name="BtnDevRefreshDisks" Grid.Column="2" Style="{StaticResource SmallButton}" Content="Refresh"/>
            </Grid>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
              <Button x:Name="BtnDevEstimate" Style="{StaticResource SecondaryButton}" Content="Estimate capacity" Margin="0,0,10,0"/>
              <Button x:Name="BtnDevDynamicBuild" Style="{StaticResource PrimaryButton}" Content="Build &amp; flash selected SD" Margin="0,0,10,0"/>
              <Button x:Name="BtnDevWriteImage" Style="{StaticResource SecondaryButton}" Content="Write prepared image"/>
            </StackPanel>
            <TextBlock x:Name="DevSdStatus" Style="{StaticResource MutedText}" Margin="0,0,0,12"/>
            <CheckBox x:Name="ChkDevRawOutput" Content="Show output and manifest paths" Margin="0,0,0,8"/>
            <StackPanel x:Name="DevRawOutput" Visibility="Collapsed">
              <Grid Margin="0,2,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="Output image path" Style="{StaticResource InputLabel}"/>
                <TextBox x:Name="TxtDevImagePath" Grid.Column="1" Style="{StaticResource PathInput}" Margin="8,3,8,3"/>
              </Grid>
              <Grid Margin="0,2,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="Manifest path" Style="{StaticResource InputLabel}"/>
                <TextBox x:Name="TxtDevManifestPath" Grid.Column="1" Style="{StaticResource PathInput}" Margin="8,3,8,3"/>
                <Button x:Name="BtnDevManifestBrowse" Grid.Column="2" Style="{StaticResource SmallButton}" Content="Browse"/>
              </Grid>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem x:Name="TabDiagnostics" Header="Diagnostics">
        <Grid Margin="4,8,4,4">
          <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <TextBox x:Name="DevLog" Grid.Row="0" Style="{StaticResource LogBox}"/>
          <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
            <Button x:Name="BtnDevOpenWorkspace" Style="{StaticResource SecondaryButton}" Content="Open workspace" Margin="0,0,10,0"/>
            <Button x:Name="BtnDevOpenLogs" Style="{StaticResource SecondaryButton}" Content="Open logs" Margin="0,0,10,0"/>
            <Button x:Name="BtnDevAbout" Style="{StaticResource SecondaryButton}" Content="About &amp; licenses"/>
          </StackPanel>
        </Grid>
      </TabItem>
      <TabItem x:Name="TabAdvanced" Header="Advanced">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Style="{StaticResource TabPagePanel}">
            <TextBlock Text="Configuration summary" Style="{StaticResource SectionLabel}" Margin="0,0,0,8"/>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <TextBlock Grid.Row="0" Grid.Column="0" Text="Application version" Style="{StaticResource InputLabel}" Margin="0,4,0,4"/>
              <TextBlock x:Name="DevAdvVersion" Grid.Row="0" Grid.Column="1" Style="{StaticResource MutedText}" Margin="0,4,0,4"/>
              <TextBlock Grid.Row="1" Grid.Column="0" Text="Repository root" Style="{StaticResource InputLabel}" Margin="0,4,0,4"/>
              <TextBlock x:Name="DevAdvRepoRoot" Grid.Row="1" Grid.Column="1" Style="{StaticResource MutedText}" Margin="0,4,0,4" TextWrapping="Wrap"/>
              <TextBlock Grid.Row="2" Grid.Column="0" Text="Workspace" Style="{StaticResource InputLabel}" Margin="0,4,0,4"/>
              <TextBlock x:Name="DevAdvWorkspace" Grid.Row="2" Grid.Column="1" Style="{StaticResource MutedText}" Margin="0,4,0,4" TextWrapping="Wrap"/>
              <TextBlock Grid.Row="3" Grid.Column="0" Text="Content cache" Style="{StaticResource InputLabel}" Margin="0,4,0,4"/>
              <TextBlock x:Name="DevAdvCache" Grid.Row="3" Grid.Column="1" Style="{StaticResource MutedText}" Margin="0,4,0,4" TextWrapping="Wrap"/>
              <TextBlock Grid.Row="4" Grid.Column="0" Text="Base image manifest" Style="{StaticResource InputLabel}" Margin="0,4,0,4"/>
              <TextBlock x:Name="DevAdvBaseManifest" Grid.Row="4" Grid.Column="1" Style="{StaticResource MutedText}" Margin="0,4,0,4" TextWrapping="Wrap"/>
              <TextBlock Grid.Row="5" Grid.Column="0" Text="Generated profiles" Style="{StaticResource InputLabel}" Margin="0,4,0,4"/>
              <TextBlock x:Name="DevAdvGeneratedProfiles" Grid.Row="5" Grid.Column="1" Style="{StaticResource MutedText}" Margin="0,4,0,4" TextWrapping="Wrap"/>
              <TextBlock Grid.Row="6" Grid.Column="0" Text="Log directory" Style="{StaticResource InputLabel}" Margin="0,4,0,4"/>
              <TextBlock x:Name="DevAdvLogs" Grid.Row="6" Grid.Column="1" Style="{StaticResource MutedText}" Margin="0,4,0,4" TextWrapping="Wrap"/>
              <TextBlock Grid.Row="7" Grid.Column="0" Text="Release repository" Style="{StaticResource InputLabel}" Margin="0,4,0,4"/>
              <TextBox x:Name="TxtDevReleaseRepo" Grid.Row="7" Grid.Column="1" Style="{StaticResource PathInput}" Margin="0,4,0,4" FontFamily="Segoe UI"/>
            </Grid>
            <TextBlock Style="{StaticResource MutedText}" Margin="0,14,0,0" Text="Developer overrides are used by the build and SD tabs above. The end-user creator always uses the pinned, verified configuration." TextWrapping="Wrap"/>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>

    <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="24,10">
      <TextBlock Style="{StaticResource MutedText}" Text="Logs and diagnostics are also written to the startup log next to the app."/>
    </Border>
  </Grid>
</Window>
