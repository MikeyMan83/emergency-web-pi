<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Emergency Web Pi"
        Width="1000" Height="700" MinWidth="920" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="14" TextOptions.TextFormattingMode="Display"
        Background="#F4F6F9" SnapsToDevicePixels="True" UseLayoutRounding="True">
  <Window.Resources>
    <SolidColorBrush x:Key="CanvasBrush" Color="#F4F6F9"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#D8DFE8"/>
    <SolidColorBrush x:Key="InkBrush" Color="#1F2937"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#5B6B7C"/>
    <SolidColorBrush x:Key="BrandBrush" Color="#0F6B9D"/>
    <SolidColorBrush x:Key="BrandDarkBrush" Color="#0B527A"/>
    <SolidColorBrush x:Key="BrandTintBrush" Color="#E8F1F8"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#1E7B44"/>
    <SolidColorBrush x:Key="SuccessTintBrush" Color="#E7F4EC"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#9A6A00"/>
    <SolidColorBrush x:Key="WarningTintBrush" Color="#FBF3DF"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#B3261E"/>
    <SolidColorBrush x:Key="DangerTintBrush" Color="#FBE9E7"/>
    <BooleanToVisibilityConverter x:Key="BoolToVis"/>

    <Style x:Key="PageTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="20"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
    </Style>
    <Style x:Key="PageSubtitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="SectionLabel" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
    </Style>
    <Style x:Key="BodyText" TargetType="TextBlock">
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="MutedText" TargetType="TextBlock">
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="MetaText" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button">
      <Setter Property="Background" Value="{StaticResource BrandBrush}"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="MinHeight" Value="38"/>
      <Setter Property="MinWidth" Value="150"/>
      <Setter Property="Padding" Value="20,8"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource BrandDarkBrush}"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BrandBrush}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="#C7CFD9"/>
                <Setter Property="Foreground" Value="#F2F4F7"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
      <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
      <Setter Property="FontWeight" Value="Normal"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#EEF2F6"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BrandBrush}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="#9AA7B4"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SmallButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="MinHeight" Value="30"/>
      <Setter Property="MinWidth" Value="0"/>
      <Setter Property="Padding" Value="12,5"/>
    </Style>

    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
      <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#8F1D17"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource DangerBrush}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="#C7CFD9"/>
                <Setter Property="Foreground" Value="#F2F4F7"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="CardRadio" TargetType="ToggleButton">
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
      <Setter Property="BorderThickness" Value="2"/>
      <Setter Property="Padding" Value="16"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="Card" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="#AEBBCA"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource BrandBrush}"/>
                <Setter Property="Background" Value="{StaticResource BrandTintBrush}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.55"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="LibraryCheck" TargetType="CheckBox">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="VerticalContentAlignment" Value="Top"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Border x:Name="Box" Width="18" Height="18" CornerRadius="4" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1.5" Background="White" VerticalAlignment="Top" Margin="0,2,0,0">
                <Path x:Name="Check" Data="M1,9 L6,14 L15,2" Stroke="{StaticResource SuccessBrush}" StrokeThickness="2.2" Stretch="Uniform" Margin="2" Visibility="Collapsed"/>
              </Border>
              <ContentPresenter Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Top"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource BrandBrush}"/>
                <Setter TargetName="Box" Property="Background" Value="{StaticResource BrandTintBrush}"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource BrandBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="ExpanderHeaderToggle" TargetType="ToggleButton">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                <Path x:Name="Chevron" Grid.Column="1" Data="M0,0 L4,4 L8,0" Stroke="{StaticResource MutedBrush}" StrokeThickness="1.5" Width="9" Height="5" Stretch="None" VerticalAlignment="Center">
                  <Path.RenderTransform>
                    <RotateTransform x:Name="ChevronRotate" CenterX="4.5" CenterY="2.5"/>
                  </Path.RenderTransform>
                </Path>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#F0F3F7"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="ChevronRotate" Storyboard.TargetProperty="Angle" To="180" Duration="0:0:0.12"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="ChevronRotate" Storyboard.TargetProperty="Angle" To="0" Duration="0:0:0.12"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SectionExpander" TargetType="Expander">
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Expander">
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="10">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <ToggleButton x:Name="HeaderToggle" Content="{TemplateBinding Header}" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}" Cursor="Hand" Padding="14,10" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch" Style="{StaticResource ExpanderHeaderToggle}"/>
                <ContentPresenter Grid.Row="1" Margin="14,0,14,14" Visibility="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolToVis}}"/>
              </Grid>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Banner" TargetType="Border">
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="14,12"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style x:Key="BannerText" TargetType="TextBlock">
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="SummaryLabel" TargetType="TextBlock">
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
      <Setter Property="VerticalAlignment" Value="Top"/>
    </Style>
    <Style x:Key="SummaryValue" TargetType="TextBlock">
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="VerticalAlignment" Value="Top"/>
    </Style>
    <Style x:Key="LogBox" TargetType="TextBox">
      <Setter Property="IsReadOnly" Value="True"/>
      <Setter Property="FontFamily" Value="Consolas"/>
      <Setter Property="FontSize" Value="11.5"/>
      <Setter Property="Background" Value="#F8FAFC"/>
      <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="8"/>
      <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="AcceptsReturn" Value="True"/>
    </Style>
    <Style x:Key="LinkText" TargetType="Hyperlink">
      <Setter Property="TextDecorations" Value="None"/>
      <Setter Property="Foreground" Value="{StaticResource BrandBrush}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="TextDecorations" Value="Underline"/>
        </Trigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>

  <Grid Margin="0">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Header -->
    <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="28,14">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="Emergency Web Pi" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}"/>
          <TextBlock Text="Offline emergency library - SD card creator" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock x:Name="VersionText" Style="{StaticResource MetaText}" VerticalAlignment="Center" Margin="0,0,16,0"/>
          <Button x:Name="BtnDeveloperTools" Style="{StaticResource SmallButton}" Content="Developer tools"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Step indicator -->
    <Border Grid.Row="1" Padding="28,14,28,10">
      <StackPanel x:Name="StepIndicator" Orientation="Horizontal" HorizontalAlignment="Left">
        <Border x:Name="StepDot1" Width="26" Height="26" CornerRadius="13" Background="#C7CFD9" VerticalAlignment="Center">
          <TextBlock x:Name="StepDotText1" Text="1" Foreground="White" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <TextBlock x:Name="StepLabel1" Text="Content" Style="{StaticResource MetaText}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,0,0"/>
        <Border x:Name="StepLine1" Width="36" Height="2" Background="{StaticResource BorderBrush}" VerticalAlignment="Center" Margin="14,0"/>
        <Border x:Name="StepDot2" Width="26" Height="26" CornerRadius="13" Background="#C7CFD9" VerticalAlignment="Center">
          <TextBlock x:Name="StepDotText2" Text="2" Foreground="White" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <TextBlock x:Name="StepLabel2" Text="Installation" Style="{StaticResource MetaText}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,0,0"/>
        <Border x:Name="StepLine2" Width="36" Height="2" Background="{StaticResource BorderBrush}" VerticalAlignment="Center" Margin="14,0"/>
        <Border x:Name="StepDot3" Width="26" Height="26" CornerRadius="13" Background="#C7CFD9" VerticalAlignment="Center">
          <TextBlock x:Name="StepDotText3" Text="3" Foreground="White" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <TextBlock x:Name="StepLabel3" Text="SD card" Style="{StaticResource MetaText}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,0,0"/>
        <Border x:Name="StepLine3" Width="36" Height="2" Background="{StaticResource BorderBrush}" VerticalAlignment="Center" Margin="14,0"/>
        <Border x:Name="StepDot4" Width="26" Height="26" CornerRadius="13" Background="#C7CFD9" VerticalAlignment="Center">
          <TextBlock x:Name="StepDotText4" Text="4" Foreground="White" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <TextBlock x:Name="StepLabel4" Text="Review" Style="{StaticResource MetaText}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,0,0"/>
      </StackPanel>
    </Border>

    <!-- Content pages -->
    <Grid x:Name="ContentHost" Grid.Row="2" Margin="28,4,28,12">

      <!-- STEP 1: Content -->
      <ScrollViewer x:Name="PageContent" VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <TextBlock Text="What do you want available offline?" Style="{StaticResource PageTitle}"/>
          <TextBlock Text="Choose the information you want to keep available when the Internet is unavailable." Style="{StaticResource PageSubtitle}" Margin="0,4,0,16"/>
          <WrapPanel x:Name="ProfileCardHost" ItemWidth="440"/>
          <Expander x:Name="CustomizeExpander" Style="{StaticResource SectionExpander}" Margin="0,8,0,0" IsExpanded="False">
            <Expander.Header>
              <Grid Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Expander}}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Customize content" Style="{StaticResource BodyText}" FontWeight="SemiBold"/>
                <TextBlock x:Name="CustomizeSummary" Grid.Column="1" Style="{StaticResource MetaText}" Margin="12,0,0,0" TextTrimming="CharacterEllipsis"/>
              </Grid>
            </Expander.Header>
            <StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,2,0,10">
                <Button x:Name="BtnSelectAll" Style="{StaticResource SmallButton}" Content="Select all" Margin="0,0,8,0"/>
                <Button x:Name="BtnSelectNone" Style="{StaticResource SmallButton}" Content="Select none"/>
              </StackPanel>
              <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="280">
                <StackPanel x:Name="LibraryListHost"/>
              </ScrollViewer>
            </StackPanel>
          </Expander>
        </StackPanel>
      </ScrollViewer>

      <!-- STEP 2: Installation -->
      <ScrollViewer x:Name="PageInstall" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
        <StackPanel>
          <TextBlock Text="How would you like to prepare your offline library?" Style="{StaticResource PageTitle}"/>
          <TextBlock Text="Both options create the same offline library on the card. The difference is when the content is downloaded." Style="{StaticResource PageSubtitle}" Margin="0,4,0,16"/>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="16"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ToggleButton x:Name="OptPrebuilt" Style="{StaticResource CardRadio}" IsChecked="True">
              <StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="Prepare everything now" Style="{StaticResource BodyText}" FontWeight="SemiBold" FontSize="15"/>
                  <Border Grid.Column="1" Background="{StaticResource BrandTintBrush}" BorderBrush="{StaticResource BrandBrush}" BorderThickness="1" CornerRadius="9" Padding="8,2">
                    <TextBlock Text="Recommended" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrandBrush}"/>
                  </Border>
                </Grid>
                <TextBlock Text="Download the selected library on this PC and prepare it on the SD card. The Raspberry Pi is ready to use offline after its first boot." Style="{StaticResource MutedText}" Margin="0,8,0,10"/>
                <StackPanel>
                  <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                    <Ellipse Width="6" Height="6" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="No Internet required on first boot" Style="{StaticResource BodyText}"/>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                    <Ellipse Width="6" Height="6" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="The selected library is already present on the card" Style="{StaticResource BodyText}"/>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                    <Ellipse Width="6" Height="6" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="Ideal for an emergency-ready card stored away for later" Style="{StaticResource BodyText}"/>
                  </StackPanel>
                </StackPanel>
              </StackPanel>
            </ToggleButton>
            <ToggleButton x:Name="OptFirstBoot" Grid.Column="2" Style="{StaticResource CardRadio}">
              <StackPanel>
                <TextBlock Text="Download content on first boot" Style="{StaticResource BodyText}" FontWeight="SemiBold" FontSize="15"/>
                <TextBlock Text="Prepare the appliance now. The Raspberry Pi downloads the selected library when an Internet connection is available. The library then remains available offline." Style="{StaticResource MutedText}" Margin="0,8,0,10"/>
                <StackPanel>
                  <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                    <Ellipse Width="6" Height="6" Fill="{StaticResource BrandBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="Less content needs to be downloaded on this PC" Style="{StaticResource BodyText}"/>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                    <Ellipse Width="6" Height="6" Fill="{StaticResource BrandBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="Useful when preparing a card before the full library is ready" Style="{StaticResource BodyText}"/>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                    <Ellipse Width="6" Height="6" Fill="{StaticResource WarningBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="The Raspberry Pi needs Internet access to retrieve content initially" Style="{StaticResource BodyText}"/>
                  </StackPanel>
                </StackPanel>
              </StackPanel>
            </ToggleButton>
          </Grid>
        </StackPanel>
      </ScrollViewer>

      <!-- STEP 3: SD card -->
      <Grid x:Name="PageSd" Visibility="Collapsed">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="Where should Emergency Web Pi be installed?" Style="{StaticResource PageTitle}"/>
        <TextBlock Grid.Row="1" Text="Select the SD card you want to erase. Everything currently on the card will be deleted." Style="{StaticResource PageSubtitle}" Margin="0,4,0,12"/>
        <Grid Grid.Row="2">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Removable drives" Style="{StaticResource SectionLabel}" VerticalAlignment="Center"/>
            <TextBlock x:Name="SdStatusText" Grid.Column="1" Style="{StaticResource MetaText}" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <Button x:Name="BtnRefreshDisks" Grid.Column="2" Style="{StaticResource SmallButton}" Content="Refresh"/>
          </Grid>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid>
              <StackPanel x:Name="DiskListHost"/>
              <Grid x:Name="SdEmptyState" Visibility="Collapsed" Margin="0,24,0,24">
                <StackPanel HorizontalAlignment="Center">
                  <Border Width="52" Height="52" CornerRadius="26" Background="{StaticResource BrandTintBrush}" HorizontalAlignment="Center">
                    <Ellipse Width="22" Height="22" Fill="{StaticResource BrandBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                  </Border>
                  <TextBlock Text="No SD card detected" Style="{StaticResource BodyText}" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,14,0,4"/>
                  <TextBlock Text="Insert an SD card into a card reader attached to this PC, then click Refresh." Style="{StaticResource MutedText}" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="420"/>
                  <Button x:Name="SdEmptyRefresh" Style="{StaticResource SecondaryButton}" Content="Refresh" Margin="0,14,0,0" HorizontalAlignment="Center"/>
                </StackPanel>
              </Grid>
            </Grid>
          </ScrollViewer>
        </Grid>
        <StackPanel Grid.Row="3">
          <Border x:Name="SdWarning" Style="{StaticResource Banner}" Background="{StaticResource WarningTintBrush}" BorderBrush="#E4D5A8" Visibility="Collapsed" Margin="0,10,0,0">
            <TextBlock Style="{StaticResource BannerText}" Foreground="#7A5A00" Text="The selected card was removed or changed. Select the card again before continuing."/>
          </Border>
          <Border x:Name="CapacityPanel" Style="{StaticResource Banner}" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" Visibility="Collapsed" Margin="0,10,0,0">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <TextBlock x:Name="CapacitySummary" Grid.Row="0" Style="{StaticResource BannerText}" Foreground="{StaticResource InkBrush}"/>
              <Canvas x:Name="CapacityTrack" Grid.Row="1" Height="8" Margin="0,10,0,0" ClipToBounds="True" Background="#E3E8EF">
                <Border x:Name="CapacityFill" Height="8" Width="40" CornerRadius="4" Background="{StaticResource BrandBrush}" Canvas.Left="0"/>
              </Canvas>
            </Grid>
          </Border>
        </StackPanel>
      </Grid>

      <!-- STEP 4: Review -->
      <ScrollViewer x:Name="PageReview" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
        <StackPanel>
          <TextBlock Text="Ready to create your Emergency Web Pi?" Style="{StaticResource PageTitle}"/>
          <TextBlock Text="Check the summary below, then create your card." Style="{StaticResource PageSubtitle}" Margin="0,4,0,16"/>
          <Border Style="{StaticResource Banner}" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" Padding="18,14">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <TextBlock Grid.Row="0" Grid.Column="0" Text="Content" Style="{StaticResource SummaryLabel}" Margin="0,6,0,6"/>
              <TextBlock x:Name="RevContent" Grid.Row="0" Grid.Column="1" Style="{StaticResource SummaryValue}" Margin="0,6,0,6"/>
              <TextBlock Grid.Row="1" Grid.Column="0" Text="Installation" Style="{StaticResource SummaryLabel}" Margin="0,6,0,6"/>
              <TextBlock x:Name="RevInstall" Grid.Row="1" Grid.Column="1" Style="{StaticResource SummaryValue}" Margin="0,6,0,6"/>
              <TextBlock Grid.Row="2" Grid.Column="0" Text="SD card" Style="{StaticResource SummaryLabel}" Margin="0,6,0,6"/>
              <TextBlock x:Name="RevCard" Grid.Row="2" Grid.Column="1" Style="{StaticResource SummaryValue}" Margin="0,6,0,6"/>
              <TextBlock Grid.Row="3" Grid.Column="0" Text="Estimated card size" Style="{StaticResource SummaryLabel}" Margin="0,6,0,6"/>
              <TextBlock x:Name="RevSize" Grid.Row="3" Grid.Column="1" Style="{StaticResource SummaryValue}" Margin="0,6,0,6"/>
              <TextBlock Grid.Row="4" Grid.Column="0" Text="Internet on first boot" Style="{StaticResource SummaryLabel}" Margin="0,6,0,6"/>
              <TextBlock x:Name="RevInternet" Grid.Row="4" Grid.Column="1" Style="{StaticResource SummaryValue}" Margin="0,6,0,6"/>
            </Grid>
          </Border>
          <Border Style="{StaticResource Banner}" Background="{StaticResource DangerTintBrush}" BorderBrush="#EFB9B5" Margin="0,14,0,0">
            <StackPanel>
              <TextBlock Style="{StaticResource BannerText}" FontWeight="SemiBold" Foreground="{StaticResource DangerBrush}" Text="All existing data on the selected SD card will be erased."/>
              <TextBlock Style="{StaticResource BannerText}" Foreground="#8A3A34" Text="The card is completely rewritten: its partitions, files, and free space are replaced by the Emergency Web Pi appliance." Margin="0,4,0,0"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <!-- Progress -->
      <Grid x:Name="PageProgress" Visibility="Collapsed">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,14">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="ProgressTitle" Text="Creating your Emergency Web Pi" Style="{StaticResource PageTitle}"/>
          <TextBlock x:Name="ProgressElapsed" Grid.Column="1" Style="{StaticResource MetaText}" VerticalAlignment="Center"/>
        </Grid>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
          <StackPanel x:Name="StageListHost"/>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Margin="0,14,0,0">
          <Canvas x:Name="BuildBarTrack" Height="8" ClipToBounds="True" Background="#E3E8EF">
            <Border x:Name="BuildBarFill" Height="8" Width="60" CornerRadius="4" Background="{StaticResource BrandBrush}" Canvas.Left="0"/>
          </Canvas>
          <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="ProgressStatus" Style="{StaticResource MutedText}" Text="Starting..."/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
              <TextBlock x:Name="CancelNote" Style="{StaticResource MetaText}" Foreground="{StaticResource WarningBrush}" VerticalAlignment="Center" Margin="0,0,10,0" Visibility="Collapsed" Text="Cancelling is not safe while the card is being written."/>
              <Button x:Name="BtnCancel" Style="{StaticResource SmallButton}" Content="Cancel"/>
            </StackPanel>
          </Grid>
        </StackPanel>
        <Expander x:Name="DetailsExpander" Grid.Row="3" Style="{StaticResource SectionExpander}" Margin="0,12,0,0" IsExpanded="False">
          <Expander.Header>
            <TextBlock x:Name="DetailsExpanderLabel" Text="Show details" Style="{StaticResource BodyText}" FontWeight="SemiBold"/>
          </Expander.Header>
          <TextBox x:Name="LogTail" Style="{StaticResource LogBox}" Height="180"/>
        </Expander>
      </Grid>

      <!-- Completion -->
      <ScrollViewer x:Name="PageDone" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
        <StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,6,0,4">
            <Border Width="44" Height="44" CornerRadius="22" Background="{StaticResource SuccessTintBrush}" VerticalAlignment="Center">
              <Ellipse Width="18" Height="18" Fill="{StaticResource SuccessBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text="Your Emergency Web Pi is ready." Style="{StaticResource PageTitle}" VerticalAlignment="Center" Margin="16,0,0,0"/>
          </StackPanel>
          <TextBlock Text="The SD card was created successfully. Keep the card in a safe place with its Wi-Fi label." Style="{StaticResource PageSubtitle}" Margin="0,2,0,16"/>
          <Border Style="{StaticResource Banner}" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" Padding="18,14">
            <StackPanel>
              <TextBlock Text="Set up your Raspberry Pi" Style="{StaticResource BodyText}" FontWeight="SemiBold" Margin="0,0,0,8"/>
              <TextBlock Style="{StaticResource BodyText}" Text="1.  Safely eject the SD card from this PC." Margin="0,3,0,0"/>
              <TextBlock Style="{StaticResource BodyText}" Text="2.  Insert the SD card into the Raspberry Pi." Margin="0,3,0,0"/>
              <TextBlock Style="{StaticResource BodyText}" Text="3.  Power on the Raspberry Pi." Margin="0,3,0,0"/>
              <TextBlock Style="{StaticResource BodyText}" Text="4.  Connect a phone or laptop to the emergency Wi-Fi network below." Margin="0,3,0,0"/>
              <TextBlock Style="{StaticResource BodyText}" Text="5.  Open any website in a browser. The Emergency Web Pi status page appears automatically. Wait until the library is ready, then click Open Library." Margin="0,3,0,0" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Banner}" Background="{StaticResource BrandTintBrush}" BorderBrush="#B9D4E6" Padding="18,14" Margin="0,12,0,0">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <TextBlock Grid.Row="0" Grid.Column="0" Text="Emergency Wi-Fi name" Style="{StaticResource SummaryLabel}" Margin="0,5,0,5"/>
              <TextBlock x:Name="WifiSsidText" Grid.Row="0" Grid.Column="1" Style="{StaticResource SummaryValue}" Margin="0,5,0,5"/>
              <TextBlock Grid.Row="1" Grid.Column="0" Text="Emergency Wi-Fi password" Style="{StaticResource SummaryLabel}" Margin="0,5,0,5"/>
              <TextBlock x:Name="WifiPasswordText" Grid.Row="1" Grid.Column="1" Style="{StaticResource SummaryValue}" Margin="0,5,0,5"/>
            </Grid>
          </Border>
          <TextBlock x:Name="WifiLabelNote" Style="{StaticResource MetaText}" Margin="0,10,0,16" TextWrapping="Wrap"/>
          <StackPanel Orientation="Horizontal">
            <Button x:Name="BtnShowInstructions" Style="{StaticResource SecondaryButton}" Content="Show setup instructions" Margin="0,0,10,0"/>
            <Button x:Name="BtnViewLog" Style="{StaticResource SecondaryButton}" Content="View log" Margin="0,0,10,0"/>
            <Button x:Name="BtnFinish" Style="{StaticResource PrimaryButton}" Content="Finish"/>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>

      <!-- Error -->
      <ScrollViewer x:Name="PageError" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
        <StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,6,0,4">
            <Border Width="44" Height="44" CornerRadius="22" Background="{StaticResource DangerTintBrush}" VerticalAlignment="Center">
              <Ellipse Width="18" Height="18" Fill="{StaticResource DangerBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text="Creating the SD card did not finish" Style="{StaticResource PageTitle}" VerticalAlignment="Center" Margin="16,0,0,0"/>
          </StackPanel>
          <TextBlock x:Name="ErrorMessage" Style="{StaticResource BodyText}" Margin="0,8,0,0"/>
          <Border Style="{StaticResource Banner}" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" Padding="18,14" Margin="0,14,0,0">
            <StackPanel>
              <TextBlock Text="What to do next" Style="{StaticResource BodyText}" FontWeight="SemiBold" Margin="0,0,0,8"/>
              <TextBlock x:Name="ErrorHint" Style="{StaticResource BodyText}" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>
          <Expander x:Name="ErrorDetailsExpander" Style="{StaticResource SectionExpander}" Margin="0,12,0,0" IsExpanded="False">
            <Expander.Header>
              <TextBlock Text="Show details" Style="{StaticResource BodyText}" FontWeight="SemiBold"/>
            </Expander.Header>
            <TextBox x:Name="ErrorLogTail" Style="{StaticResource LogBox}" Height="180"/>
          </Expander>
          <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
            <Button x:Name="BtnBackToReview" Style="{StaticResource SecondaryButton}" Content="Back to review" Margin="0,0,10,0"/>
            <Button x:Name="BtnErrorFinish" Style="{StaticResource PrimaryButton}" Content="Finish"/>
          </StackPanel>
          <TextBlock Style="{StaticResource MetaText}" Foreground="{StaticResource WarningBrush}" Margin="0,12,0,0" Text="Do not remove the SD card while a write is in progress. If a write was interrupted, create the card again from the beginning." TextWrapping="Wrap"/>
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <!-- Footer navigation -->
    <Border x:Name="FooterBar" Grid.Row="3" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="28,12">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Button x:Name="BtnBack" Grid.Column="0" Style="{StaticResource SecondaryButton}" Content="Back"/>
        <TextBlock x:Name="FooterHint" Grid.Column="1" Style="{StaticResource MetaText}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16,0"/>
        <Button x:Name="BtnContinue" Grid.Column="2" Style="{StaticResource PrimaryButton}" Content="Continue"/>
      </Grid>
    </Border>
  </Grid>
</Window>
